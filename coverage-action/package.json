{
  "name": "@local/coverage-action",
  "private": true,
  "version": "1.0.0",
  "description": "GitHub Action to parse Cobertura coverage reports",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings",
    "format": "oxlint --fix",
    "package": "npm run build",
    "package:watch": "npm run build:watch",
    "build": "rolldown -c",
    "build:watch": "rolldown -c --watch"
  },
  "keywords": [
    "github",
    "actions",
    "coverage"
  ],
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "glob-promise": "^6.0.7",
    "xml2js": "^0.6.2"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
